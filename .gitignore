# KiCad backup and lock files
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
_autosave-*

# Generated artefacts
kicad/**/netlist/
kicad/**/bom/
kicad/**/gerber/

# Claude Code working files — not tracked
.claude/
docs/superpowers/
docs/claude_code_workflow.html

# Brainstorm session content
.superpowers/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.log
data/
!smart_gate/data/
/var/

# PlatformIO (ESP32 build cache + downloaded libs)
firmware/.pio/

# KiCad generated outputs (re-emit via build_combined.py / KiCad export)
kicad/**/*.svg
kicad/**/*.svg.json
kicad/**/no_zone-*
kicad/**/*.erc
kicad/**/*.dsn
kicad/**/*.ses
kicad/**/*.rules
kicad/**/skidl_REPL.*
kicad/**/drc_report.txt

# FreeCAD generated exports (sources are *.FCStd)
freecad/exports/
*.step
